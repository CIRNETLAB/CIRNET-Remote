# Example for a local PostgreSQL Unix socket with the dedicated OS/database role.
# Provision the role/database and peer authentication before using this URL.
CIRNET_ENV=production
CIRNET_ALLOW_GUEST=false
CIRNET_DATABASE_URL=postgresql+psycopg://cirnet@/cirnet?host=/var/run/postgresql
CIRNET_TRUSTED_ORIGINS=https://lab.example.invalid
CIRNET_SESSION_TTL_SECONDS=86400
CIRNET_HARDWARE_MODE=simulation
CIRNET_HARDWARE_GRPC_TARGET=127.0.0.1:50051
CIRNET_SIMULATION_WORKERS=4
CIRNET_SIMULATION_BACKEND=legacy
CIRNET_CAPTURE_DIR=/var/lib/cirnet/captures
CIRNET_CAPTURE_MAX_BYTES=268435456
CIRNET_CAPTURE_MAX_FILES=4096
CIRNET_CAPTURE_RETENTION_SECONDS=2592000
