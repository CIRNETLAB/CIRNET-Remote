# Example for a local PostgreSQL Unix socket with the dedicated OS/database role.
# Provision the role/database and peer authentication before using this URL.
NETCIRCUIT_ENV=production
NETCIRCUIT_ALLOW_GUEST=false
NETCIRCUIT_DATABASE_URL=postgresql+psycopg://netcircuit@/netcircuit?host=/var/run/postgresql
NETCIRCUIT_TRUSTED_ORIGINS=https://lab.example.invalid
NETCIRCUIT_SESSION_TTL_SECONDS=86400
NETCIRCUIT_HARDWARE_MODE=simulation
NETCIRCUIT_HARDWARE_GRPC_TARGET=127.0.0.1:50051
NETCIRCUIT_SIMULATION_WORKERS=4
NETCIRCUIT_SIMULATION_BACKEND=legacy
NETCIRCUIT_CAPTURE_DIR=/var/lib/netcircuit/captures
NETCIRCUIT_CAPTURE_MAX_BYTES=268435456
NETCIRCUIT_CAPTURE_MAX_FILES=4096
NETCIRCUIT_CAPTURE_RETENTION_SECONDS=2592000
