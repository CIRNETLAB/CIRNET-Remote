{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Local editor memory image 1.0",
  "type":"object",
  "required":["version","word_bits","depth","data"],
  "properties":{
    "version":{"const":"1.0"},
    "word_bits":{"const":8},
    "depth":{"type":"integer","minimum":1,"maximum":256},
    "data":{"type":"array","minItems":1,"maxItems":256,"items":{"type":"integer","minimum":0,"maximum":255}}
  },
  "additionalProperties":false,
  "$comment":"Consumers must also check data.length === depth. This local initial image is not a capture or physical RAM capability."
}
