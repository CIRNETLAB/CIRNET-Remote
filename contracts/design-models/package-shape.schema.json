{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netcircuit.local/contracts/design/package-shape/1.0/schema.json",
  "title": "Sealed procedural package shape 1.0",
  "$defs": {
    "PackageLeadSectionV1": {
      "type": "object",
      "required": [
        "kind",
        "widthMm",
        "thicknessMm"
      ],
      "properties": {
        "kind": {
          "enum": [
            "round",
            "rectangular",
            "stamped"
          ]
        },
        "widthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "thicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "shoulderWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "PackageLeadExitV1": {
      "type": "object",
      "required": [
        "pinId",
        "positionMm",
        "normal"
      ],
      "properties": {
        "pinId": {
          "type": "string",
          "minLength": 1
        },
        "positionMm": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.x/module.schema.json#/$defs/point"
        },
        "normal": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.x/module.schema.json#/$defs/point"
        }
      },
      "additionalProperties": false
    },
    "PackageShapeV1": {
      "type": "object",
      "required": [
        "version",
        "family",
        "embeddedDepthMm",
        "leadSection",
        "leadExits"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "family": {
          "enum": [
            "resistor",
            "diode",
            "zener",
            "ceramic",
            "electrolytic",
            "led",
            "dip",
            "to92",
            "tactile",
            "slide-switch",
            "dip-switch",
            "seven-segment",
            "buzzer"
          ]
        },
        "embeddedDepthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.5
        },
        "leadSection": {
          "$ref": "#/$defs/PackageLeadSectionV1"
        },
        "leadExits": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/PackageLeadExitV1"
          }
        },
        "lensDiameterMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "flangeDiameterMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "flangeHeightMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "domeRadiusMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "bevelMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "caseHeightMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "buttonDiameterMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "buttonTravelMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "coverThicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "rivetDiameterMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "sheetThicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "baseThicknessMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "knobLengthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "knobWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "knobHeightMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "slotLengthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "slotWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "travelMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "recessDepthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "actuatorWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "actuatorLengthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "digitHeightMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "digitWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "strokeWidthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "decimalPointDiameterMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "slantDegrees": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "digitPitchMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "faceInsetMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "openingDiameterMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "openingDepthMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "shoulderRadiusMm": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false,
      "description": "Versioned model geometry in centered body-local millimetres. Body envelope, contact tips, exits and the hidden interior embed remain distinct; no electrical or safety capability is implied.",
      "allOf": [
        {
          "if": {
            "properties": {
              "family": {
                "const": "tactile"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "required": [
              "caseHeightMm",
              "buttonDiameterMm",
              "buttonTravelMm",
              "coverThicknessMm",
              "rivetDiameterMm",
              "bevelMm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "slide-switch"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "required": [
              "caseHeightMm",
              "sheetThicknessMm",
              "baseThicknessMm",
              "knobLengthMm",
              "knobWidthMm",
              "knobHeightMm",
              "slotLengthMm",
              "slotWidthMm",
              "travelMm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "dip-switch"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "required": [
              "caseHeightMm",
              "slotWidthMm",
              "slotLengthMm",
              "recessDepthMm",
              "actuatorWidthMm",
              "actuatorLengthMm",
              "travelMm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "seven-segment"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "required": [
              "digitHeightMm",
              "digitWidthMm",
              "strokeWidthMm",
              "decimalPointDiameterMm",
              "slantDegrees",
              "digitPitchMm",
              "faceInsetMm",
              "bevelMm"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "family": {
                "const": "buzzer"
              }
            },
            "required": [
              "family"
            ]
          },
          "then": {
            "required": [
              "openingDiameterMm",
              "openingDepthMm",
              "shoulderRadiusMm"
            ]
          }
        }
      ]
    }
  }
}
