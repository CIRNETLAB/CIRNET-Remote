{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netcircuit.local/contracts/public/placement/2.0/schema.json",
  "title": "Explicit graph 1.2 application boundaries 2.0",
  "$defs": {
    "CircuitSummaryV2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph_schema_version": {
          "enum": [
            "1.0",
            "1.1",
            "1.2"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "project_id",
        "owner_id",
        "name",
        "graph_schema_version",
        "revision",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "CircuitDocumentV2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph_schema_version": {
          "enum": [
            "1.0",
            "1.1",
            "1.2"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.2/schema.json#/$defs/AnySupportedCircuitGraph"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "project_id",
        "owner_id",
        "name",
        "graph_schema_version",
        "revision",
        "created_at",
        "updated_at",
        "graph"
      ],
      "additionalProperties": false
    },
    "CircuitPageV2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "https://netcircuit.local/contracts/public/placement/2.0/schema.json#/$defs/CircuitSummaryV2"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "schema_version",
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "CircuitCreateV2": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.2/schema.json#/$defs/AnySupportedCircuitGraph"
        }
      },
      "required": [
        "name",
        "graph"
      ],
      "additionalProperties": false
    },
    "CircuitSaveV2": {
      "type": "object",
      "properties": {
        "base_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.2/schema.json#/$defs/AnySupportedCircuitGraph"
        }
      },
      "required": [
        "base_revision",
        "name",
        "graph"
      ],
      "additionalProperties": false
    },
    "ExperimentDocumentReferenceV2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "enum": [
            "INLINE_GRAPH",
            "SAVED_DOCUMENT",
            "ASSIGNMENT_CONTEXT"
          ]
        },
        "execution_mode": {
          "enum": [
            "simulation",
            "hardware"
          ]
        },
        "circuit_id": {
          "type": "string",
          "minLength": 1
        },
        "graph_schema_version": {
          "anyOf": [
            {
              "enum": [
                "1.0",
                "1.1",
                "1.2"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "assignment_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "experiment_id",
        "snapshot_id",
        "source",
        "execution_mode",
        "circuit_id",
        "graph_schema_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "SAVED_DOCUMENT"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "document_id",
              "revision"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "document_id"
                  ]
                },
                {
                  "required": [
                    "revision"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "ASSIGNMENT_CONTEXT"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "graph_schema_version": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "graph_schema_version": {
                "enum": [
                  "1.0",
                  "1.1",
                  "1.2"
                ]
              }
            }
          }
        }
      ]
    },
    "ExperimentCreateV2": {
      "type": "object",
      "properties": {
        "station_id": {
          "type": "string",
          "minLength": 1
        },
        "assignment_id": {
          "type": "string",
          "minLength": 1
        },
        "circuit_graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.2/schema.json#/$defs/AnySupportedCircuitGraph"
        },
        "clock_config": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false
            },
            {
              "$ref": "https://netcircuit.local/contracts/physical-lab/1.0/lab.schema.json#/$defs/ClockConfiguration"
            }
          ]
        },
        "generator_config": {
          "type": "array",
          "items": {
            "$ref": "https://netcircuit.local/contracts/physical-lab/1.0/lab.schema.json#/$defs/GeneratorConfiguration"
          }
        },
        "capture_config": {
          "$ref": "https://netcircuit.local/contracts/physical-lab/1.0/lab.schema.json#/$defs/CaptureConfiguration"
        },
        "test_vectors": {
          "type": "array",
          "items": {
            "$ref": "https://netcircuit.local/contracts/public/common/1.0/schema.json#/$defs/TestVector"
          }
        },
        "circuit_document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "circuit_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "station_id"
      ],
      "additionalProperties": false,
      "dependentRequired": {
        "circuit_document_id": [
          "circuit_revision"
        ],
        "circuit_revision": [
          "circuit_document_id"
        ]
      },
      "allOf": [
        {
          "if": {
            "required": [
              "circuit_document_id"
            ]
          },
          "then": {
            "not": {
              "required": [
                "circuit_graph"
              ]
            }
          }
        }
      ]
    },
    "SimulationRequestV2": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "2.0"
        },
        "graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.2/schema.json#/$defs/AnySupportedCircuitGraph"
        },
        "capture_config": {
          "$ref": "https://netcircuit.local/contracts/physical-lab/1.0/lab.schema.json#/$defs/CaptureConfiguration"
        },
        "test_vectors": {
          "type": "array",
          "items": {
            "$ref": "https://netcircuit.local/contracts/public/common/1.0/schema.json#/$defs/TestVector"
          }
        },
        "clock_config": {
          "anyOf": [
            {
              "type": "object",
              "maxProperties": 0
            },
            {
              "$ref": "https://netcircuit.local/contracts/physical-lab/1.0/lab.schema.json#/$defs/ClockConfiguration"
            }
          ]
        },
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "graph",
        "capture_config"
      ],
      "additionalProperties": false
    }
  }
}
