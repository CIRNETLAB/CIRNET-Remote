{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netcircuit.local/contracts/public/projects/1.0/schema.json",
  "title": "Private projects and immutable circuit documents 1.0",
  "$defs": {
    "Project": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "access_scope": {
          "const": "private"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "owner_id",
        "name",
        "description",
        "revision",
        "created_at",
        "updated_at",
        "access_scope"
      ],
      "additionalProperties": false
    },
    "ProjectPage": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/Project"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "schema_version",
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "ProjectCreate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "ProjectUpdate": {
      "type": "object",
      "properties": {
        "base_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "required": [
        "base_revision"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "name"
          ]
        },
        {
          "required": [
            "description"
          ]
        }
      ]
    },
    "ProjectDelete": {
      "type": "object",
      "properties": {
        "base_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "base_revision"
      ],
      "additionalProperties": false
    },
    "ProjectDeletion": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deleted": {
          "const": true
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "deleted",
        "revision"
      ],
      "additionalProperties": false
    },
    "CircuitSummary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph_schema_version": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.x/circuit.schema.json#/properties/schema_version"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "project_id",
        "owner_id",
        "name",
        "graph_schema_version",
        "revision",
        "created_at",
        "updated_at"
      ],
      "additionalProperties": false
    },
    "CircuitDocument": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "owner_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph_schema_version": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.x/circuit.schema.json#/properties/schema_version"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "created_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "updated_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.x/circuit.schema.json"
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "project_id",
        "owner_id",
        "name",
        "graph_schema_version",
        "revision",
        "created_at",
        "updated_at",
        "graph"
      ],
      "additionalProperties": false
    },
    "CircuitPage": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/CircuitSummary"
          }
        },
        "next_cursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 256
        }
      },
      "required": [
        "schema_version",
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "CircuitCreate": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.x/circuit.schema.json"
        }
      },
      "required": [
        "name",
        "graph"
      ],
      "additionalProperties": false
    },
    "CircuitSave": {
      "type": "object",
      "properties": {
        "base_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "graph": {
          "$ref": "https://netcircuit.local/contracts/circuit/1.x/circuit.schema.json"
        }
      },
      "required": [
        "base_revision",
        "name",
        "graph"
      ],
      "additionalProperties": false
    },
    "CircuitDelete": {
      "type": "object",
      "properties": {
        "base_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "base_revision"
      ],
      "additionalProperties": false
    },
    "CircuitDeletion": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "deleted": {
          "const": true
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "document_id",
        "deleted",
        "revision"
      ],
      "additionalProperties": false
    },
    "ExperimentDocumentReference": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0"
        },
        "experiment_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "snapshot_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "source": {
          "enum": [
            "INLINE_GRAPH",
            "SAVED_DOCUMENT",
            "ASSIGNMENT_CONTEXT"
          ]
        },
        "execution_mode": {
          "enum": [
            "simulation",
            "hardware"
          ]
        },
        "circuit_id": {
          "type": "string",
          "minLength": 1
        },
        "graph_schema_version": {
          "anyOf": [
            {
              "$ref": "https://netcircuit.local/contracts/circuit/1.x/circuit.schema.json#/properties/schema_version"
            },
            {
              "type": "null"
            }
          ]
        },
        "assignment_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "document_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "schema_version",
        "experiment_id",
        "snapshot_id",
        "source",
        "execution_mode",
        "circuit_id",
        "graph_schema_version"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "SAVED_DOCUMENT"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "document_id",
              "revision"
            ]
          },
          "else": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "document_id"
                  ]
                },
                {
                  "required": [
                    "revision"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "ASSIGNMENT_CONTEXT"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "properties": {
              "graph_schema_version": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "graph_schema_version": {
                "$ref": "https://netcircuit.local/contracts/circuit/1.x/circuit.schema.json#/properties/schema_version"
              }
            }
          }
        }
      ]
    }
  }
}
