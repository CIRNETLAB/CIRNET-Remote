CIRNET_ENV=development
CIRNET_API_HOST=127.0.0.1
CIRNET_API_PORT=8000
CIRNET_HARDWARE_MODE=simulation
CIRNET_DATABASE_URL=sqlite:///./cirnet.db
CIRNET_HARDWARE_GRPC_TARGET=127.0.0.1:50051
CIRNET_SIMULATION_WORKERS=4
CIRNET_SIMULATION_BACKEND=legacy
CIRNET_CAPTURE_DIR=.runtime/captures
CIRNET_CAPTURE_MAX_BYTES=268435456
CIRNET_CAPTURE_MAX_FILES=4096
CIRNET_CAPTURE_RETENTION_SECONDS=2592000
CIRNET_ALLOW_GUEST=true
CIRNET_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CIRNET_SESSION_TTL_SECONDS=86400
# Production: CIRNET_ENV=production, ALLOW_GUEST=false, an explicit HTTPS
# TRUSTED_ORIGINS list, a PostgreSQL URL and an absolute persistent CAPTURE_DIR.
# Keep credentials out of this file. Bootstrap the first admin with the CLI prompt.
# Retention is explicit maintenance; 0 disables expiration but retries pending cleanup.
# Run one API worker; SIMULATION_WORKERS bounds virtual jobs, not HTTP sessions.
