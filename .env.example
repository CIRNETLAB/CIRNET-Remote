NETCIRCUIT_ENV=development
NETCIRCUIT_API_HOST=127.0.0.1
NETCIRCUIT_API_PORT=8000
NETCIRCUIT_HARDWARE_MODE=simulation
NETCIRCUIT_DATABASE_URL=sqlite:///./netcircuit.db
NETCIRCUIT_HARDWARE_GRPC_TARGET=127.0.0.1:50051
NETCIRCUIT_SIMULATION_WORKERS=4
NETCIRCUIT_CAPTURE_DIR=.runtime/captures
NETCIRCUIT_CAPTURE_MAX_BYTES=268435456
NETCIRCUIT_CAPTURE_MAX_FILES=4096
NETCIRCUIT_CAPTURE_RETENTION_SECONDS=2592000
NETCIRCUIT_ALLOW_GUEST=true
NETCIRCUIT_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NETCIRCUIT_SESSION_TTL_SECONDS=86400
# Production: NETCIRCUIT_ENV=production, ALLOW_GUEST=false, an explicit HTTPS
# TRUSTED_ORIGINS list, a PostgreSQL URL and an absolute persistent CAPTURE_DIR.
# Keep credentials out of this file. Bootstrap the first admin with the CLI prompt.
# Retention is explicit maintenance; 0 disables expiration but retries pending cleanup.
# Run one API worker; SIMULATION_WORKERS bounds virtual jobs, not HTTP sessions.
